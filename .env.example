# Copy to .env only if it does not already exist; never commit credentials.
POSTGRES_DB=activity
POSTGRES_USER=activity
# Use letters and digits only: the password is also embedded in the web DATABASE_URL.
POSTGRES_PASSWORD=replace-with-a-local-password
WEB_PORT=8080
METRICS_PORT=9090
# dev-seed (default) loads refreshable fixture data. Any other value (e.g. live) skips it.
LIQUIBASE_CONTEXTS=dev-seed
# Optional header/footer branding (defaults: Engineering / Activity / Your repositories):
# BRAND_ORGANIZATION=Acme
# BRAND_TEAM=Engineering
# BRAND_SCOPE=Platform
# BRAND_LINK_LABEL=Open Platform repo
# BRAND_LINK_URL=https://dev.azure.com/acme/Platform/_git/Platform
# Only for the optional `collector` profile against a live (non-fixture) database:
# AZURE_DEVOPS_ORG=acme
# AZURE_DEVOPS_PROJECT=Platform
# AZURE_DEVOPS_REPOSITORIES=Platform,Firmware
# AZURE_DEVOPS_PAT=
